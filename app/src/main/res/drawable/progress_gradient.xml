<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/foz_dark2" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/foz_red"
                    android:centerColor="@color/foz_red2"
                    android:endColor="@color/foz_orange2" />
            </shape>
        </clip>
    </item>
</layer-list>
